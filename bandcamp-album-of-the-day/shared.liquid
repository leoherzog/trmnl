{% template main %}
{% assign album = title %}

{% if artist == blank or album == blank %}
<div class="layout layout--center">
  <span class="label label--gray">No Album of the Day</span>
</div>

{% else %}
{% comment %} Per-size layout config — the single markup block below renders from these.
Defaults are the row layout shared by full/half-horizontal/quadrant; half-vertical overrides. {% endcomment %}
{% assign layout_class = 'layout layout--row layout--stretch-y' %}
{% assign img_class = 'image image-dither image--cover aspect--1/1 h--full rounded' %}
{% assign text_class = 'flex flex--col flex--center-y stretch-x' %}

{% case layout_size %}
{% when 'full' %}
  {% assign text_class = text_class | append: ' gap--medium lg:gap--large p--6' %}
  {% assign title_class = 'title title--large lg:title--xlarge' %}
  {% assign title_clamp = '3' %}{% assign title_clamp_lg = '4' %}
  {% assign artist_class = 'description lg:description--large' %}
  {% assign artist_clamp = '2' %}{% assign artist_clamp_lg = '3' %}
{% when 'half-horizontal' %}
  {% assign text_class = text_class | append: ' gap--small lg:gap--medium p--4 lg:p--6' %}
  {% assign title_class = 'title title--small md:title--base lg:title--large' %}
  {% assign title_clamp = '2' %}{% assign title_clamp_lg = '3' %}
  {% assign artist_class = 'description lg:description--large' %}
  {% assign artist_clamp = '1' %}{% assign artist_clamp_lg = '2' %}
{% when 'half-vertical' %}
  {% assign layout_class = 'layout layout--col' %}
  {% assign img_class = 'image image-dither image--cover aspect--1/1 grow self--center rounded' %}
  {% assign text_class = 'flex flex--col stretch-x gap--small lg:gap--medium p--4 lg:p--6' %}
  {% assign title_class = 'title title--small lg:title--base' %}
  {% assign title_clamp = '2' %}{% assign title_clamp_lg = '3' %}
  {% assign artist_class = 'label lg:label--large' %}
  {% assign artist_clamp = '1' %}{% assign artist_clamp_lg = '2' %}
{% when 'quadrant' %}
  {% assign text_class = text_class | append: ' gap--small p--2' %}
  {% assign title_class = 'title title--small' %}
  {% assign title_clamp = '2' %}{% assign title_clamp_lg = '' %}
  {% assign artist_class = 'label label--small' %}
  {% assign artist_clamp = '1' %}{% assign artist_clamp_lg = '' %}
{% endcase %}

<div class="{{ layout_class }}">
  <img class="{{ img_class }}" src="{{ image_url }}">
  <div class="{{ text_class }}">
    <span class="{{ title_class }}" data-clamp="{{ title_clamp }}"{% if title_clamp_lg != '' %} data-clamp-lg="{{ title_clamp_lg }}"{% endif %}>{{ album }}</span>
    <span class="{{ artist_class }}" data-clamp="{{ artist_clamp }}"{% if artist_clamp_lg != '' %} data-clamp-lg="{{ artist_clamp_lg }}"{% endif %}>{{ artist }}</span>
  </div>
</div>
{% endif %}

{% render 'title_bar', trmnl: trmnl, date: date %}
{% endtemplate %}
